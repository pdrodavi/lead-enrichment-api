# =============================================================================
# Lead Enrichment API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control!
# =============================================================================

# === Servidor ===
PORT=8081

# === Banco de Dados (PostgreSQL) — OBRIGATÓRIO ===
DB_URL=jdbc:postgresql://localhost:5432/lead_enrichment
DB_USERNAME=postgres
DB_PASSWORD=change_me

# === HikariCP (pool de conexões) ===
HIKARI_MAX_POOL=10
HIKARI_MIN_IDLE=2

# === Redis (cache distribuído L2) — opcional, desabilitado se vazio ===
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POOL_MAX=8
REDIS_POOL_IDLE=4
REDIS_POOL_MIN=1

# === OpenSERP (Google Search API self-hosted) ===
OPENSERP_API_URL=http://localhost:7000
OPENSERP_API_URL_2=
OPENSERP_API_URL_3=

# === Segurança — OBRIGATÓRIAS ===
API_KEY=your-api-key-here
ENCRYPTION_SECRET=your-32-byte-encryption-secret-here

# === Timing Filter (desabilitado por padrão) ===
TIMING_FILTER_ENABLED=false

# === Tomcat ===
TOMCAT_CONN_TIMEOUT=60000
TOMCAT_KEEPALIVE_TIMEOUT=60000

# === Compression ===
COMPRESSION_ENABLED=true
COMPRESSION_MIN_SIZE=1024

# === Async / Threads ===
ASYNC_TIMEOUT=60000
VIRTUAL_THREADS=true

# === JPA / Hibernate (⚠️ `validate` em produção!) ===
DDL_AUTO=update

# === Connection Pools ===
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONN_TIMEOUT=10000
HIKARI_MAX_LIFETIME=600000
REDIS_TIMEOUT=5000

# === OpenTelemetry / Jaeger Tracing ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_ENABLED=true
TRACING_SAMPLING=1.0

# === Extras ===
ENV=dev
