# ===================== Environment Variables =====================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control!

# --- PostgreSQL ---
PG_USER=postgres
PG_PASSWORD=change_me
PG_DB=postgres
PG_PORT=5433
DB_URL=jdbc:postgresql://localhost:${PG_PORT:-5433}/${PG_DB:-postgres}
DB_USERNAME=${PG_USER:-postgres}
DB_PASSWORD=${PG_PASSWORD:-change_me}

# --- OpenSERP ---
OPENSERP_API_URL=https://openserp.pdroti.solutions

# --- API Security ---
API_KEY=your-api-key-here
ENCRYPTION_SECRET=your-32-byte-encryption-secret-here

# --- Application ---
PORT=8081
ENV=dev
